{
  "name": "ai-harness",
  "version": "0.1.0",
  "description": "AI Coding Harness v0.1 — Repository -> Task -> Run -> Workspace -> Codex CLI -> Verification -> Review",
  "private": true,
  "type": "module",
  "bin": {
    "ai": "./dist/cli/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:postgres": "AI_TEST_POSTGRES=1 vitest run tests/postgres.integration.test.ts",
    "test:e2e:real": "AI_TEST_POSTGRES=1 AI_TEST_CODEX=1 vitest run tests/realE2E.integration.test.ts",
    "test:docker": "AI_TEST_DOCKER=1 vitest run tests/dockerAcceptance.integration.test.ts",
    "test:docker:network": "AI_TEST_DOCKER=1 AI_NETWORK_ENFORCEMENT=1 vitest run tests/dockerAcceptance.integration.test.ts",
    "test:e2e:phase12": "vitest run tests/e2e/phase12",
    "test:release-gate": "node scripts/verify-phase12.mjs",
    "test:watch": "vitest",
    "demo:repository": "node scripts/demo-repository.mjs",
    "demo:task": "node scripts/demo-task.mjs",
    "demo:workspace": "node scripts/demo-workspace.mjs",
    "demo:run": "node scripts/demo-run.mjs",
    "demo:worker": "node scripts/demo-worker.mjs",
    "demo:loop": "node scripts/demo-loop.mjs",
    "demo:review": "node scripts/demo-review.mjs",
    "demo:codex": "node scripts/demo-real-codex.mjs",
    "start": "node dist/cli/index.js",
    "db:migrate": "npm run build && node scripts/migrate.mjs"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.74.0",
    "commander": "^12.1.0",
    "pg": "^8.13.1",
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "@types/node": "^18.19.50",
    "@types/pg": "^8.11.10",
    "typescript": "^5.6.3",
    "vitest": "^1.6.0"
  }
}
