# /srv/ai-harness/deploy/ai-harness.env   (chmod 600, never committed)
#
# Copy to deploy/ai-harness.env and fill in. The service refuses to start when
# FEISHU_APP_ID / FEISHU_APP_SECRET / AI_LLM_API_KEY are missing.

# ---- Feishu app ------------------------------------------------------------
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Who may drive the harness. Empty = deny everyone (the bot replies with the
# sender's open_id so you can paste it here, then restart).
FEISHU_ALLOWED_OPEN_IDS=ou_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional role overrides (role map) — guest | developer | reviewer | admin.
FEISHU_DEFAULT_ROLE=developer
# FEISHU_ROLE_MAP=ou_reviewer=reviewer,ou_boss=admin
# Delivery notifications (READY_FOR_RELEASE / BLOCKED) go here when set.
# FEISHU_DEFAULT_CHAT_ID=oc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Model provider (OpenAI-compatible) ------------------------------------
# Used for intent parsing + problem analysis. Also export the same key as
# DEEPSEEK_API_KEY so the Codex CLI can reach its provider.
AI_LLM_BASE_URL=https://api.deepseek.com
AI_LLM_MODEL=deepseek-v4-flash
AI_LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Codex config overrides (`-c key=value`) applied to every agent Run.
# The execution container is generic: it has no provider config and no
# credentials, so the provider wiring is supplied here and the key travels as
# a SecretStore secret (register repositories with --secret DEEPSEEK_API_KEY).
AI_CODEX_CONFIG='{"model_provider":"deepseek","model":"deepseek-v4-flash","model_providers.deepseek.name":"deepseek","model_providers.deepseek.base_url":"https://api.deepseek.com","model_providers.deepseek.wire_api":"responses","model_providers.deepseek.env_key":"DEEPSEEK_API_KEY"}'

# ---- Harness ---------------------------------------------------------------
DATABASE_URL=postgres://ai:ai@127.0.0.1:55432/ai_harness
AI_EXECUTION_DRIVER=docker
AI_MAX_CONCURRENCY=1
AI_LOOP_INTERVAL_MS=2000
AI_WORKSPACES_DIR=/root/ai-workspaces
# TASK-1238: per-repository cache the Run containers may write (npm tarballs +
# frontend build cache). Keeps `npm ci`/build cheap without a warm image; the
# harness mounts only <AI_CACHE_DIR>/<repositoryId>/*. Default /var/cache/ai-harness.
# AI_CACHE_DIR=/var/cache/ai-harness
AI_AUTO_BOOTSTRAP_SPECIFICATION=true
# TASK-1219: after a specification is planned, run Task Intake automatically so
# tasks become READY and the scheduler starts them — no per-task human "运行".
# Set to false to go back to manual intake + manual start.
AI_AUTO_START=true
# TASK-1221: who reviews a passing Run.
#   on     = 评审 agent 自动通过"验收标准全部有可执行证明"的改动（默认）
#   shadow = 只记录评审结论，不改任务状态（观察期）
#   off    = 全部由人评审
AI_REVIEWER=on

# ---- GitHub App（TASK-1230：部署监控）--------------------------------------
# 部署由各仓库的 GitHub Actions 负责（见 docs/test-environment-deployment-plan.md）。
# harness 只用 App 推 test/<dlv> 分支、开/合并 PR、读 workflow run 状态。
# 填了下面三项就用 App；否则回退到 AI_GITHUB_TOKEN（fine-grained PAT，有有效期）。
# App 权限：Contents r/w、Pull requests r/w、Actions read、Metadata read。
AI_GITHUB_APP_ID=
AI_GITHUB_APP_ACCOUNT=i12n
# 留空 = 自动发现（推荐）；只有需要固定某次安装时才填。
AI_GITHUB_APP_INSTALLATION_ID=
AI_GITHUB_APP_PRIVATE_KEY_PATH=/srv/ai-harness/deploy/github-app.pem
# 测试分支是 test/<dlv>；把 test/ 纳入可推送前缀（多个用逗号分隔）。
AI_GIT_PUSH_PREFIX=ai/,test/
# TASK-1231：部署后自动监控 GitHub Actions 的 run 状态并推送结果（off 则只能手动查）。
AI_DEPLOY_WATCH=on
AI_DEPLOY_WATCH_INTERVAL_SECONDS=30
AI_DEPLOY_WATCH_TTL_MINUTES=30
# 测试环境地址：部署完成的消息里会带上它（GitHub 负责部署，harness 无法自行发现）。
AI_DEPLOY_TEST_URL=http://47.100.5.48:18080/

# ---- 预览构建证据（TASK-1226）----------------------------------------------
# 部署由 GitHub Actions 负责（见 docs/test-environment-deployment-plan.md），
# harness 只构建改动并收集证据；所有仓库共用这一套，无 per-repo 配置。
AI_PREVIEW_MEMORY_MB=768
AI_PREVIEW_CPUS=1
# 预览构建容器唯一可访问的外部主机（装依赖用）。
AI_PREVIEW_ALLOW=registry.npmjs.org
# TASK-1215: tokens allowed per UTC day across all Runs. 0 (default) = no cap.
# A Run's usage is always recorded in run.result.usage either way.
# AI_TOKEN_BUDGET_PER_DAY=2000000

# There is no web console: every setting below is read/written from chat
# (see docs/deployment-feishu.md §3.1). The service writes this very file.
# AI_ENV_FILE=deploy/ai-harness.env

# ---- Optional --------------------------------------------------------------
# AI_CONFIG_PATH=/srv/ai-harness/config/config.yaml
# AI_CODEX_BIN=/usr/local/bin/codex
# Run cap; the default is 1800000 (30 min). Set 0 to disable the timeout.
# AI_RUN_TIMEOUT_MS=1800000
# AI_INTENT_NOTES=Repositories: repo-xmusic = the Rehelu music app.
